{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
  "dev": "tsx watch src/server.ts",
  "build": "tsc",
  "start": "node dist/server.js",
  "contract:emit": "prisma contract emit",
  "catalog:import": "tsx scripts/importCatalog.ts",
  "catalog:export-cars": "tsx scripts/carsCatalog.ts export",
  "catalog:seed-cars": "tsx scripts/carsCatalog.ts seed",
  "catalog:clean-cars": "tsx scripts/carsCatalog.ts seed --prune",
  "catalog:clean-cars:apply": "tsx scripts/carsCatalog.ts seed --prune --apply"
},
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "@prisma/orm-postgres": "^8.0.0-rc.7",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.14",
    "prisma": "^8.0.0-rc.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
